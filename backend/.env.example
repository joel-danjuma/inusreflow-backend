ENVIRONMENT=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://insureflow:insureflow@localhost:5432/insureflow
REDIS_URL=redis://localhost:6379/0

# Squad (GTBank) Payment API -- sandbox and live credentials must never be
# co-loaded. Collection is via Dynamic Virtual Accounts (bank transfer push),
# not card/bank direct-debit -- see docs/adr/0004-squad-virtual-account-collection.md.
SQUAD_SECRET_KEY=
SQUAD_PUBLIC_KEY=
SQUAD_BASE_URL=https://sandbox-api-d.squadco.com
SQUAD_MERCHANT_ID=
SQUAD_DYNAMIC_VA_DURATION_SECONDS=1800
# Required for broker approval (POST /virtual-account/business rejects a
# missing/empty value). Your own 10-digit GTBank account number in live;
# in sandbox any well-formed 10-digit string is accepted -- create one via
# a throwaway POST /virtual-account/business call and use its
# virtual_account_number.
SQUAD_BENEFICIARY_ACCOUNT=
