# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local secrets -- .env* catches every variant (.env, .env.production,
# .env.sandbox, etc.) except the committed template, never enumerate
# variants individually here.
.env*
!.env.example

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Generated by tests/load/ (seed_data.py, locustfile.py) -- regenerate, don't commit
tests/load/seed_data.json
tests/load/results/

# Client-specific demo seed data -- names a real prospective client and a
# known shared login password; kept out of the public repo entirely rather
# than just gitignoring its password. Deployed to the VPS out-of-band
# (scp/rsync), not via git -- update it the same way if it ever changes.
scripts/seed_demo_data.py

